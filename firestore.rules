rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function self(uid){ return signedIn() && request.auth.uid == uid; }
    function admin(){ return signedIn() && request.auth.token.email == 'admin@bibun.pl'; }
    function member(sid){ return signedIn() && exists(/databases/$(database)/documents/servers/$(sid)) && request.auth.uid in get(/databases/$(database)/documents/servers/$(sid)).data.members; }
    function owner(sid){ return signedIn() && exists(/databases/$(database)/documents/servers/$(sid)) && get(/databases/$(database)/documents/servers/$(sid)).data.ownerId == request.auth.uid; }

    function serverPerm(sid, perm) {
      return signedIn() && exists(/databases/$(database)/documents/servers/$(sid)) && (
        get(/databases/$(database)/documents/servers/$(sid)).data.ownerId == request.auth.uid ||
        admin() ||
        (exists(/databases/$(database)/documents/serverMembers/$(sid + '_' + request.auth.uid)) &&
         ('serverPermissions' in get(/databases/$(database)/documents/serverMembers/$(sid + '_' + request.auth.uid)).data) &&
         get(/databases/$(database)/documents/serverMembers/$(sid + '_' + request.auth.uid)).data.serverPermissions.hasAny([perm, 'ADMINISTRATOR']))
      );
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if self(uid);
      allow update: if admin() || (self(uid) && (!('discriminator' in resource.data) || request.resource.data.discriminator == resource.data.discriminator) && (!('badges' in resource.data) || request.resource.data.badges == resource.data.badges) && (!('createdServerCount' in resource.data) || request.resource.data.createdServerCount == resource.data.createdServerCount) && (request.resource.data.username == resource.data.username || !('usernameChangedAt' in resource.data) || resource.data.usernameChangedAt == null || request.time >= resource.data.usernameChangedAt + duration.value(7, 'd')) && (request.resource.data.username == resource.data.username || request.resource.data.usernameChangedAt == request.time));
      allow delete: if self(uid) || admin();
    }
    match /servers/{sid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid || admin() ||
        (serverPerm(sid,'MANAGE_SERVER') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','icon','banner','public','requireApproval','defaultNotifications','contentFilter'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && !(request.auth.uid in resource.data.members) && request.auth.uid in request.resource.data.members && request.resource.data.members.hasAll(resource.data.members) && request.resource.data.members.size() == resource.data.members.size() + 1)
      );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || admin());
    }
    match /serverMembers/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.resource.data.userId==request.auth.uid || admin() || owner(request.resource.data.serverId));
      allow update: if signedIn() && (
        admin() || owner(resource.data.serverId) ||
        (resource.data.userId==request.auth.uid && request.resource.data.serverId==resource.data.serverId && request.resource.data.userId==resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','lastSeen','timeoutUntil'])) ||
        (serverPerm(resource.data.serverId,'MANAGE_ROLES') && request.resource.data.serverId==resource.data.serverId && request.resource.data.userId==resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roleIds','serverPermissions','permissionsSyncedAt','nickname'])) ||
        (serverPerm(resource.data.serverId,'MANAGE_MEMBERS') && request.resource.data.serverId==resource.data.serverId && request.resource.data.userId==resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','timeoutUntil']))
      );
      allow delete: if signedIn() && (admin() || owner(resource.data.serverId) || resource.data.userId==request.auth.uid);
    }
    match /serverRoles/{id} { allow read: if signedIn(); allow create: if signedIn() && serverPerm(request.resource.data.serverId,'MANAGE_ROLES'); allow update,delete: if signedIn() && serverPerm(resource.data.serverId,'MANAGE_ROLES'); }
    match /categories/{id} { allow read: if signedIn(); allow create: if signedIn() && serverPerm(request.resource.data.serverId,'MANAGE_CHANNELS'); allow update,delete: if signedIn() && serverPerm(resource.data.serverId,'MANAGE_CHANNELS'); }
    match /channels/{id} { allow read: if signedIn(); allow create: if signedIn() && serverPerm(request.resource.data.serverId,'MANAGE_CHANNELS'); allow update,delete: if signedIn() && serverPerm(resource.data.serverId,'MANAGE_CHANNELS'); }
    function serverMemberDoc(sid){ return exists(/databases/$(database)/documents/serverMembers/$(sid + '_' + request.auth.uid)); }
    function canSendChannel(sid,cid){
      if(!signedIn()) return false;
      if(owner(sid)||admin()) return true;
      if(!member(sid)||!serverMemberDoc(sid)) return false;
      let mem=get(/databases/$(database)/documents/serverMembers/$(sid + '_' + request.auth.uid)).data;
      if('timeoutUntil' in mem && mem.timeoutUntil != null && mem.timeoutUntil > request.time) return false;
      let ch=get(/databases/$(database)/documents/channels/$(cid)).data;
      if('permissionDenyEveryone' in ch && 'SEND_MESSAGES' in ch.permissionDenyEveryone && ch.permissionDenyEveryone.SEND_MESSAGES == true){
        if(!('permissionAllowEveryone' in ch) || !('SEND_MESSAGES' in ch.permissionAllowEveryone) || ch.permissionAllowEveryone.SEND_MESSAGES != true){
          if(!('permissionAllowRoles' in ch) || !('SEND_MESSAGES' in ch.permissionAllowRoles) || !mem.roleIds.hasAny(ch.permissionAllowRoles.SEND_MESSAGES)) return false;
        }
      }
      if('permissionDenyRoles' in ch && 'SEND_MESSAGES' in ch.permissionDenyRoles && mem.roleIds.hasAny(ch.permissionDenyRoles.SEND_MESSAGES)){
        if(!('permissionAllowRoles' in ch) || !('SEND_MESSAGES' in ch.permissionAllowRoles) || !mem.roleIds.hasAny(ch.permissionAllowRoles.SEND_MESSAGES)) return false;
      }
      return true;
    }
    match /messages/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.uid == request.auth.uid && canSendChannel(request.resource.data.serverId, request.resource.data.channelId); allow update,delete: if signedIn() && (resource.data.uid == request.auth.uid || admin()); }
    match /dms/{id} { allow read: if signedIn() && request.auth.uid in resource.data.participants; allow create: if signedIn() && request.auth.uid in request.resource.data.participants && request.resource.data.from == request.auth.uid; allow update,delete: if signedIn() && request.auth.uid in resource.data.participants; }
    match /friendRequests/{id} { allow read: if signedIn() && (resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid); allow create: if signedIn() && request.resource.data.fromId == request.auth.uid && request.resource.data.toId != request.auth.uid; allow update: if signedIn() && (resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid); allow delete: if signedIn() && (resource.data.toId == request.auth.uid || resource.data.fromId == request.auth.uid); }
    match /blocks/{id} { allow read,create,update,delete: if signedIn(); }
    match /serverInvites/{id} { allow read: if signedIn(); allow create: if signedIn() && serverPerm(request.resource.data.serverId,'MANAGE_INVITES'); allow update,delete: if signedIn() && serverPerm(resource.data.serverId,'MANAGE_INVITES'); }
    match /serverJoinRequests/{id} { allow read,create,update,delete: if signedIn(); }
    match /bans/{id} { allow read: if signedIn() && serverPerm(resource.data.serverId,'BAN_MEMBERS'); allow create: if signedIn() && request.resource.data.userId != request.auth.uid && (!exists(/databases/$(database)/documents/servers/$(request.resource.data.serverId)) || request.resource.data.userId != get(/databases/$(database)/documents/servers/$(request.resource.data.serverId)).data.ownerId); allow update,delete: if signedIn(); }
    match /auditLogs/{id} { allow read: if signedIn() && serverPerm(resource.data.serverId,'MANAGE_SERVER'); allow create: if signedIn() && serverPerm(request.resource.data.serverId,'MANAGE_SERVER'); }
    match /fileMeta/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid; allow update,delete: if signedIn() && (resource.data.ownerId == request.auth.uid || admin()); }
    match /fileChunks/{id} { allow read: if signedIn(); allow create,update,delete: if signedIn(); }
    match /bots/{id} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || admin());
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update,delete: if signedIn() && (resource.data.ownerId == request.auth.uid || admin());
    }
    match /botProfiles/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update,delete: if signedIn() && (resource.data.ownerId == request.auth.uid || admin());
    }
    match /botInstallations/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (owner(request.resource.data.serverId) || request.auth.uid == request.resource.data.ownerId || admin());
      allow update,delete: if signedIn() && (owner(resource.data.serverId) || request.auth.uid == resource.data.ownerId || admin());
    }
  }
}
